# Secrets des Edge Functions pour le développement LOCAL.
# Copier en `supabase/functions/.env.local` (ignoré par git) puis renseigner.
# En local, SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont
# injectés automatiquement par `supabase functions serve`.

# Origine du site pour les URLs de retour Stripe (dev : port Vite).
SITE_URL=http://127.0.0.1:5174

# Clé Stripe de TEST (sk_test_...). Sans elle, le checkout renvoie
# « stripe_unavailable » (tout le reste du Shop fonctionne).
STRIPE_SECRET_KEY=

# Secret du webhook Stripe (whsec_...). Optionnel en local ; utile avec
# `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/stripe-webhook`.
STRIPE_WEBHOOK_SECRET=

# Brevo (contacts / newsletter). Clé API xkeysib-... — jamais commitée.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DOYA
# Expéditeur Brevo : sender vérifié. Avant live → adresse @domaine pro (pas Gmail). Staging : almenaprod@gmail.com.

# Cloudflare R2 (upload photos bio depuis l’admin)
R2_S3_ENDPOINT=
R2_BUCKET=doya-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=https://pub-5b2b2b3b50ba46c485eeff926fa26420.r2.dev

# Note : les forfaits port sont dans `_shared/shipping.ts` (pas de SHIPPING_CENTS).

# Destinataire atelier des mails « nouvelle commande » (défaut almenaprod@gmail.com).
ORDER_NOTIFY_EMAIL=almenaprod@gmail.com
