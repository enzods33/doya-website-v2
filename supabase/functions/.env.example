# Secrets des Edge Functions pour le développement LOCAL.
# Copier en `supabase/functions/.env.local` (ignoré par git) puis renseigner.
# En local, SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY sont
# injectés automatiquement par `supabase functions serve`.

# Frais de port en centimes (ex. 800 = 8,00 €).
SHIPPING_CENTS=800

# Origine du site pour les URLs de retour Stripe (dev : port Vite).
SITE_URL=http://127.0.0.1:5174

# Clé Stripe de TEST (sk_test_...). Sans elle, le checkout renvoie
# « stripe_unavailable » (tout le reste du Shop fonctionne).
STRIPE_SECRET_KEY=

# Secret du webhook Stripe (whsec_...). Optionnel en local ; utile avec
# `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/stripe-webhook`.
STRIPE_WEBHOOK_SECRET=
