# Renseigner le domaine HTTPS vérifié avant publication officielle.
VITE_SITE_URL=
# Garder false pendant la relecture privée et tant que les contenus sont incomplets.
VITE_INDEXABLE=false

# Médias publics (Cloudflare R2). Sans slash final.
# Ex. https://pub-xxxxx.r2.dev
VITE_ASSETS_URL=

# Scripts d’upload R2 (jamais committer les secrets — .env.local uniquement)
# R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=doya-assets
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Boutique : clés publiques seulement. Les secrets Stripe restent dans Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
