# Garder false pendant la relecture privée et tant que les contenus sont incomplets.
VITE_INDEXABLE=false

# Boutique : clés publiques seulement. Les secrets Stripe restent dans Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
